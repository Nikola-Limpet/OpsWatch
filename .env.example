# Local .env is ignored by git. Never send credentials through Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_USER_ID=
# Optional second Railway account: account token, not a project token.
RAILWAY_SECOND_API_TOKEN=
# A dedicated read-only monitoring connection, preferably an unpooled Neon URL.
NEON_DATABASE_URL=
# Optional signed event ingestion and custom edge-firewall integration.
OPSWATCH_INGEST_SECRET=
OPSWATCH_BLOCK_TOKEN=
# Optional outbound bridge to the private Vercel dashboard.
OPSWATCH_RELAY_URL=
OPSWATCH_RELAY_BRIDGE_TOKEN=
OPSWATCH_RELAY_BYPASS_TOKEN=
