# Dedicated table. Only incoming web traffic is affected; SSH stays reachable.
# Load once on the target server with: sudo nft -f opswatch.nft
# A reverse proxy/CDN hides client IPs here. Use its edge firewall instead in that case.
table inet opswatch {
    set blocked4 {
        type ipv4_addr
        flags timeout
        timeout 15m
    }
    set blocked6 {
        type ipv6_addr
        flags timeout
        timeout 15m
    }
    chain web_blocks {
        type filter hook input priority -10; policy accept;
        tcp dport { 80, 443 } ip saddr @blocked4 drop
        tcp dport { 80, 443 } ip6 saddr @blocked6 drop
    }
}
